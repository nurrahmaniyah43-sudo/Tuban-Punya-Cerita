                        imgBg: "from-sky-500 to-blue-600",
                        iconImg: "fa-umbrella-beach"
                    },
                    {
                        title: "Pantai Semilir",
                        category: "Pantai",
                        desc: "Destinasi wisata pesisir pantai dengan hamparan pasir bersih dan pemandangan laut yang menenteramkan.",
                        url: "https://dhavinarya610-source.github.io/Pantai-Semilir/",
                        imgBg: "from-cyan-500 to-blue-700",
                        iconImg: "fa-sun"
                    },
                    {
                        title: "Makam Sunan Bejagung Kidul",
                        category: "Religi",
                        desc: "Wisata ziarah makam Syekh Abdullah Asy'ari (Sunan Bejagung Kidul) tokoh ulama penyebar Islam.",
                        url: "https://ferdiansyahariful-ship-it.github.io/wisata-makam-sunan-bejagung-kidul/",
                        imgBg: "from-stone-700 to-stone-900",
                        iconImg: "fa-place-of-worship"
                    },
                    {
