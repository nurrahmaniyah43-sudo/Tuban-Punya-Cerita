                    }
                ]
            },
            {
                id: "abu_ubaidah",
                className: "Kelas Abu Ubaidah Al Jarrah",
                icon: "fa-flag",
                badgeColor: "bg-rose-100 text-rose-800 border border-rose-200",
                items: [
                    {
                        title: "Eksplorasi Wisata Tuban",
                        category: "Eco Park",
                        desc: "Portal rangkuman eksplorasi ragam keindahan destinasi wisata alam dan budaya Kabupaten Tuban.",
                        url: "https://abiyyums84-oss.github.io/wisata/",
                        imgBg: "from-indigo-600 to-sky-800",
                        iconImg: "fa-compass"
                    },
                    {
                        title: "Wisata Pantai Dermaga",
                        category: "Pantai",
                        desc: "Pesona bahari pantai dermaga dengan panorama laut Jawa dan spot swafoto menarik.",
                        url: "https://admeire.github.io/Website-wisata-pantaidermaga-Tugaskokurikuler/",
                        imgBg: "from-blue-600 to-teal-800",
                        iconImg: "fa-anchor"
                    },
                    {
                        title: "Wisata Masjid Agung Tuban",
                        category: "Religi",
                        desc: "Masjid megah bernuansa 1001 malam dengan arsitektur memukau di alun-alun pusat kota Tuban.",
                        url: "https://websitemasjidagung.netlify.app",
                        imgBg: "from-amber-600 to-yellow-700",
                        iconImg: "fa-mosque"
                    },
                    {
                        title: "Wisata Pemandian Bektiharjo",
                        category: "Eco Park",
                        desc: "Sumber mata air pemandian legendaris berair bening sejuk yang dikelilingi pepohonan tua ramah kera.",
                        url: "https://pratamagaming853-cloud.github.io/wisata-mbektiharjo-tuban/",
                        imgBg: "from-emerald-500 to-teal-700",
                        iconImg: "fa-water"
                    },
                    {
                        title: "Wisata Pantai Remen Tuban",
                        category: "Pantai",
                        desc: "Pantai unik berpasir putih dengan laguna air payau alami yang tenang dan jernih.",
                        url: "https://riza99-creator.github.io/pantai-remen/",
                        imgBg: "from-sky-500 to-indigo-700",
                        iconImg: "fa-umbrella-beach"
                    },
                    {
                        title: "Sumber Mata Air Krawak",
                        category: "Air Terjun",
                        desc: "Wisata pemandian sungai dan aliran sumber mata air Krawak yang jernih dan menyegarkan.",
                        url: "https://alhaidarjibrani.github.io/sumbermataairkrawak/?utm_source=chatgpt.com",
                        imgBg: "from-teal-600 to-blue-800",
                        iconImg: "fa-droplet"
                    },
                    {
                        title: "Suruan Eco Park Tuban",
                        category: "Eco Park",
                        desc: "Destinasi wisata hijau petualangan alam susur sungai dan rekreasi keluarga di Tuban.",
                        url: "https://abiliverson.github.io/Website-suruan-ecopark-tuban/",
                        imgBg: "from-green-600 to-emerald-800",
                        iconImg: "fa-leaf"
                    }
                ]
            }
        ];

        let activeClassFilter = "all";
        let activeCategoryFilter = "all";
        let searchQuery = "";

        // DOM elements
        const searchInput = document.getElementById("searchInput");
        const clearSearchBtn = document.getElementById("clearSearchBtn");
        const destinationsContainer = document.getElementById("destinationsContainer");
        const noResults = document.getElementById("noResults");
        const statTotal = document.getElementById("statTotal");
        const currentFilterTitle = document.getElementById("currentFilterTitle");

        function getClassNameById(id) {
            const found = classesData.find(c => c.id === id);
            return found ? found.className : id;
        }

        function renderDestinations() {
            destinationsContainer.innerHTML = "";
            let totalRendered = 0;

            classesData.forEach(classGroup => {
                // Filter by class if selected in top nav
                if (activeClassFilter !== "all" && classGroup.id !== activeClassFilter) {
                    return;
                }

                // Filter items by category & search query
                const filteredItems = classGroup.items.filter(item => {
                    const matchCategory = (activeCategoryFilter === "all" || item.category === activeCategoryFilter);
                    const matchQuery = (searchQuery === "" || 
                        item.title.toLowerCase().includes(searchQuery.toLowerCase()) || 
                        item.desc.toLowerCase().includes(searchQuery.toLowerCase()) ||
                        item.category.toLowerCase().includes(searchQuery.toLowerCase()));
                    return matchCategory && matchQuery;
                });

                if (filteredItems.length > 0) {
                    totalRendered += filteredItems.length;

                    // Create Section per Class
                    const classBlock = document.createElement("div");
                    classBlock.className = "space-y-5";

                    classBlock.innerHTML = `
                        <div class="flex items-center justify-between border-b border-slate-200 pb-3">
                            <div class="flex items-center space-x-3">
                                <div class="w-10 h-10 rounded-2xl bg-sky-600 text-white flex items-center justify-center font-bold shadow-md">
                                    <i class="fa-solid ${classGroup.icon}"></i>
                                </div>
                                <div>
                                    <h3 class="text-lg sm:text-xl font-extrabold text-slate-800">${classGroup.className}</h3>
                                    <p class="text-xs text-slate-500 font-medium">${filteredItems.length} Destinasi Wisata</p>
                                </div>
                            </div>
                            <span class="px-3 py-1 rounded-full text-[11px] font-bold ${classGroup.badgeColor}">
                                ${classGroup.id.toUpperCase()}
                            </span>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
                            ${filteredItems.map(item => createCardHTML(item, classGroup.className)).join('')}
                        </div>
                    `;

                    destinationsContainer.appendChild(classBlock);
                }
            });

            // Update stats & fallback state
            statTotal.textContent = `${totalRendered} Wisata`;

            if (totalRendered === 0) {
                noResults.classList.remove("hidden");
            } else {
                noResults.classList.add("hidden");
            }

            // Update header title
            if (searchQuery !== "") {
                currentFilterTitle.textContent = `Hasil Pencarian: "${searchQuery}"`;
            } else if (activeClassFilter !== "all" && activeCategoryFilter !== "all") {
                currentFilterTitle.textContent = `${getClassNameById(activeClassFilter)} • Kategori ${activeCategoryFilter}`;
            } else if (activeClassFilter !== "all") {
                currentFilterTitle.textContent = `Menampilkan ${getClassNameById(activeClassFilter)}`;
            } else if (activeCategoryFilter !== "all") {
                currentFilterTitle.textContent = `Kategori Wisata: ${activeCategoryFilter}`;
            } else {
                currentFilterTitle.textContent = "Menampilkan Semua Wisata Tuban";
            }
        }

        function createCardHTML(item, className) {
            let catBadgeClass = "bg-slate-100 text-slate-700";
            if (item.category === "Pantai") catBadgeClass = "bg-sky-500 text-white";
            if (item.category === "Religi") catBadgeClass = "bg-amber-500 text-white";
            if (item.category === "Air Terjun") catBadgeClass = "bg-teal-500 text-white";
            if (item.category === "Goa") catBadgeClass = "bg-stone-600 text-white";
            if (item.category === "Eco Park") catBadgeClass = "bg-emerald-600 text-white";

            return `
                <div class="group bg-white rounded-3xl overflow-hidden border border-slate-200 hover:border-sky-400 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between">
                    <div>
                        <!-- Header Visual Banner -->
                        <div class="w-full h-32 bg-gradient-to-br ${item.imgBg} flex items-center justify-center text-white relative overflow-hidden">
                            <div class="absolute inset-0 bg-slate-900/10"></div>
                            <i class="fa-solid ${item.iconImg} text-4xl opacity-80 group-hover:scale-110 transition-transform duration-300"></i>
                            
                            <!-- Category Badge -->
                            <span class="absolute top-3 left-3 px-3 py-1 rounded-full text-[10px] font-extrabold uppercase tracking-wider ${catBadgeClass} shadow-md">
                                ${item.category}
                            </span>
                        </div>

                        <!-- Card Content -->
                        <div class="p-5">
                            <div class="flex items-center space-x-1 text-[11px] font-semibold text-sky-600 mb-1">
                                <i class="fa-solid fa-location-dot"></i>
                                <span>Tuban, Jawa Timur</span>
                            </div>

                            <h3 class="text-base font-extrabold text-slate-900 group-hover:text-sky-600 transition-colors line-clamp-2 mb-2 leading-snug">
                                ${item.title}
                            </h3>

                            <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
                                ${item.desc}
                            </p>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="px-5 pb-5 pt-3 border-t border-slate-100 flex items-center space-x-2">
                        <a href="${item.url}" target="_blank" rel="noopener noreferrer" 
                           class="flex-grow py-2.5 px-3 bg-sky-600 hover:bg-sky-700 text-white rounded-2xl text-xs font-bold text-center transition-all flex items-center justify-center space-x-1.5 shadow-md shadow-sky-600/20">
                            <span>Kunjungi</span>
                            <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
                        </a>

                        <button onclick="openPreviewModal('${escapeHtml(item.title)}', '${item.url}', '${item.category}')" 
                                title="Lihat Modal Preview" 
                                class="w-10 h-10 bg-slate-100 hover:bg-sky-50 text-slate-700 hover:text-sky-600 rounded-2xl text-xs flex items-center justify-center transition-all shrink-0">
                            <i class="fa-solid fa-eye"></i>
                        </button>

                        <button onclick="copyToClipboard('${item.url}')" 
                                title="Salin Link Website" 
                                class="w-10 h-10 bg-slate-100 hover:bg-sky-50 text-slate-700 hover:text-sky-600 rounded-2xl text-xs flex items-center justify-center transition-all shrink-0">
                            <i class="fa-solid fa-link"></i>
                        </button>
                    </div>
                </div>
            `;
        }

        function escapeHtml(str) {
            return str.replace(/'/g, "\\'");
        }

        function executeSearch() {
            searchQuery = searchInput.value.trim();
            if (searchQuery.length > 0) {
                clearSearchBtn.classList.remove("hidden");
            } else {
                clearSearchBtn.classList.add("hidden");
            }
            renderDestinations();
        }

        function clearSearch() {
            searchInput.value = "";
            searchQuery = "";
            clearSearchBtn.classList.add("hidden");
            renderDestinations();
        }

        function filterByClass(cls) {
            activeClassFilter = cls;

            document.querySelectorAll(".top-class-btn").forEach(btn => {
                if (btn.dataset.class === cls) {
                    btn.className = "top-class-btn px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all bg-sky-500 text-white shadow-sm";
                } else {
                    btn.className = "top-class-btn px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all bg-sky-800/80 text-sky-200 hover:bg-sky-700 hover:text-white";
                }
            });

            renderDestinations();
        }

        function filterByCategory(cat) {
            activeCategoryFilter = cat;

            document.querySelectorAll(".cat-chip-btn").forEach(btn => {
                if (btn.dataset.category === cat) {
                    btn.className = "cat-chip-btn px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all bg-sky-100 text-sky-800 border border-sky-200";
                } else {
                    btn.className = "cat-chip-btn px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all bg-slate-100 text-slate-600 hover:bg-sky-50";
                }
            });

            renderDestinations();
        }

        function resetFilters() {
            activeClassFilter = "all";
            activeCategoryFilter = "all";
            searchQuery = "";
            if (searchInput) searchInput.value = "";
            if (clearSearchBtn) clearSearchBtn.classList.add("hidden");

            filterByClass("all");
            filterByCategory("all");
        }

        // Preview modal functions
        function openPreviewModal(title, url, category) {
            const modal = document.getElementById("previewModal");
            const modalTitle = document.getElementById("modalTitle");
            const modalBadge = document.getElementById("modalCategoryBadge");
            const modalExternalBtn = document.getElementById("modalExternalBtn");
            const iframe = document.getElementById("previewIframe");
            const loader = document.getElementById("iframeLoader");

            modalTitle.textContent = title;
            modalBadge.textContent = category;
            modalExternalBtn.href = url;
            if (loader) loader.style.display = "flex";

            let formattedUrl = url;
            if (!formattedUrl.startsWith("http://") && !formattedUrl.startsWith("https://")) {
                formattedUrl = "https://" + formattedUrl;
            }

            iframe.src = formattedUrl;
            modal.classList.remove("hidden");
            document.body.style.overflow = "hidden";
        }

        function closePreviewModal() {
            const modal = document.getElementById("previewModal");
            const iframe = document.getElementById("previewIframe");
            iframe.src = "";
            modal.classList.add("hidden");
            document.body.style.overflow = "auto";
        }

        function hideIframeLoader() {
            const loader = document.getElementById("iframeLoader");
            if (loader) loader.style.display = "none";
        }

        function copyToClipboard(text) {
            const tempInput = document.createElement("input");
            tempInput.value = text;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand("copy");
            document.body.removeChild(tempInput);

            showToast("Link destinasi berhasil disalin!");
        }

        function showToast(msg) {
            const toast = document.getElementById("toast");
            const toastMsg = document.getElementById("toastMsg");
            toastMsg.textContent = msg;

            toast.classList.remove("hidden");
            setTimeout(() => {
                toast.classList.remove("translate-y-10", "opacity-0");
                toast.classList.add("translate-y-0", "opacity-100");
            }, 10);

            setTimeout(() => {
                toast.classList.remove("translate-y-0", "opacity-100");
                toast.classList.add("translate-y-10", "opacity-0");
                setTimeout(() => {
                    toast.classList.add("hidden");
                }, 300);
            }, 3000);
        }

        // Initialize display on load
        window.onload = function() {
            renderDestinations();
        }
    </script>
</body>
</html>
